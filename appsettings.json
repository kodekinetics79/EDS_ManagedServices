{
  "AllowedHosts": "*",
  "Evostel": {
    "CommercialApiBaseUrl": "https://evostel-latest.runasp.net",
    "OperationsMode": "Representative",
    "SupportEmail": "info@kodekinetics.com",
    "ServiceProbeIntervalSeconds": 60,
    "ServiceProbes": [
      {
        "Id": "storefront",
        "Path": "/api/commercial/ProductCollections/hierarchy"
      },
      {
        "Id": "commercial-api",
        "Path": "/api/commercial/ProductCollections"
      },
      {
        "Id": "d365",
        "Path": "/api/commercial/MasterData/countries"
      },
      {
        "Id": "payments",
        "Path": "/api/commercial/MasterData/payment-methods"
      },
      {
        "Id": "notifications",
        "Path": "/api/commercial/Notifications"
      },
      {
        "Id": "ticketing",
        "Path": "/api/commercial/Orders/support-tickets"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
