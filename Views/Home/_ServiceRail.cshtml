@model IReadOnlyList<ServiceStatus>
<section class="panel service-rail" aria-labelledby="service-rail-title"><div class="section-heading"><div><h2 id="service-rail-title">Service rail</h2><p>End-to-end platform status and response times</p></div><div class="legend"><span><i class="healthy"></i>Healthy</span><span><i class="degraded"></i>Degraded</span><span><i class="unavailable"></i>Issue</span></div></div><div class="service-track">@foreach(var service in Model){<button class="service-node @service.Status" type="button" data-service-node data-name="@service.Name" data-status="@service.Status" data-latency="@service.Latency" data-availability="@service.Availability" data-owner="@service.Owner" data-source="@service.Source" data-detail="@service.Detail"><span class="node-icon" aria-hidden="true">●</span><strong>@service.Name</strong><small data-latency>@service.Latency ms</small><em data-status>@service.Status</em></button>}</div></section>
