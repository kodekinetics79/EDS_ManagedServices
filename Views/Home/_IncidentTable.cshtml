@model IncidentTableViewModel
<section class="panel table-panel incident-panel"><div class="section-heading"><div><h2>@(Model.Embedded ? "Active incidents" : "Incident register")</h2><p><span id="incident-count">@Model.Incidents.Count</span> operational records</p></div>@if(Model.Embedded){<a href="/incidents">View all</a>}</div>@if(!Model.Embedded){<div class="table-tools"><label class="search-field"><span class="sr-only">Search incidents</span><input id="incident-search" type="search" placeholder="Search incident, service, or owner"><button type="button" id="clear-search" aria-label="Clear incident search">×</button></label><label><span class="sr-only">Severity</span><select id="severity-filter"><option value="">All severities</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label><label><span class="sr-only">Status</span><select id="status-filter"><option value="">All statuses</option><option value="investigating">Investigating</option><option value="in-progress">In progress</option><option value="monitoring">Monitoring</option><option value="acknowledged">Acknowledged</option><option value="resolved">Resolved</option></select></label></div>}<div class="table-wrap"><table id="incident-table"><thead><tr><th>Severity</th><th>Incident</th><th>Service</th><th>Owner</th><th>Elapsed</th><th>SLA remaining</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>@foreach(var incident in Model.Incidents){<tr data-incident-row data-id="@incident.Id" data-title="@incident.Title" data-service="@incident.Service" data-severity="@incident.Severity" data-owner="@incident.Owner" data-elapsed="@incident.Elapsed" data-sla="@incident.SlaRemaining" data-status="@incident.Status" data-opened="@incident.OpenedAt" data-summary="@incident.Summary"><td><span class="severity severity-@incident.Severity">@incident.Severity</span></td><td><strong>@incident.Id</strong><small>@incident.Title</small></td><td>@incident.Service</td><td>@incident.Owner</td><td>@incident.Elapsed</td><td><div class="sla"><span>@incident.SlaRemaining</span><i style="--progress:@incident.SlaPercent%"></i></div></td><td><span class="status status-@incident.Status">@incident.Status</span></td><td><button class="button button-small incident-view" type="button">View</button></td></tr>}<tr id="incident-empty" hidden><td colspan="8"><div class="empty-state"><strong>No incidents match these filters</strong><span>Clear the search or filters to restore the register.</span><button class="button button-outline" type="button" id="empty-clear">Clear filters</button></div></td></tr></tbody></table></div></section>
