@model IReadOnlyList<ActivityItem>
<aside class="activity-feed" aria-labelledby="activity-title"><div class="section-heading"><div><h2 id="activity-title">Activity</h2><p>Today · Arabia Standard Time</p></div><a href="/activity">View all</a></div><div class="activity-list">@foreach(var item in Model.Take(6)){<article class="activity-item"><i class="activity-dot @item.Tone"></i><time>@item.Time</time><div><strong>@item.Title</strong><span>@item.Detail</span></div></article>}</div><nav class="quick-links" aria-label="Quick links"><a href="/reports">Weekly report <span>→</span></a><a href="/compliance">Compliance evidence <span>→</span></a><a href="/support">Support queue <span>→</span></a></nav></aside>
